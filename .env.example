# Copy this file to .env and fill in real values.
# Telegram: talk to @BotFather, create BPCommentary_bot, then paste the token.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Together.ai: https://api.together.xyz/
TOGETHER_API_KEY=your_together_api_key_here
TOGETHER_MODEL=deepseek-ai/DeepSeek-V3

# LLM provider: "together" or "glm" (Zhipu BigModel, OpenAI-compatible)
LLM_PROVIDER=together
# GLM config (used when LLM_PROVIDER=glm) — https://open.bigmodel.cn/
GLM_API_KEY=your_glm_api_key_here
GLM_MODEL=glm-4.5-flash

# TON static address + TonAPI polling
TON_PAYMENT_WALLET=UQAW6okaS3s0NxEbv0HW7LVyhmrvUrG-foXlZBB4ace8s334
TONAPI_KEY=your_tonapi_key_here
SINGLE_ANALYSIS_TON=50
MONTHLY_SUBSCRIPTION_TON=200
